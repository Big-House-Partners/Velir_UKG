
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Big House Partners — Reference Examples</title>
    <style>
        :root {
            --primary: #0f1419;
            --secondary: #1a2332;
            --accent: #e8e8e8;
            --accent-subtle: #8b8b8b;
            --highlight: #ffffff;
            --border: #2d3744;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: var(--primary);
            color: var(--accent);
            line-height: 1.6;
            overflow-x: hidden;
        }

        header {
            padding: 2rem 2rem 3rem 2rem;
            text-align: center;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(180deg, var(--secondary) 0%, var(--primary) 100%);
            animation: slideDown 0.8s ease-out;
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 1.5rem;
            opacity: 0;
            animation: fadeInLogo 0.8s ease-out 0.2s forwards;
        }

        @keyframes fadeInLogo {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .eyebrow {
            font-size: 0.8rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--accent-subtle);
            margin-bottom: 0.75rem;
            font-weight: 500;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 300;
            letter-spacing: 1px;
            margin-bottom: 0.75rem;
            color: var(--highlight);
        }

        .subtitle {
            font-size: 1.05rem;
            color: var(--accent-subtle);
            font-weight: 300;
            letter-spacing: 0.3px;
            max-width: 640px;
            margin: 0 auto;
        }

        main {
            max-width: 900px;
            margin: 0 auto;
            padding: 4rem 2rem;
        }

        .note {
            background: var(--secondary);
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            border-radius: 8px;
            padding: 1.85rem 2.25rem;
            margin-bottom: 3rem;
            font-size: 1rem;
        }

        .note .eyebrow {
            color: var(--accent);
            margin-bottom: 1.1rem;
        }

        .note p {
            color: var(--accent);
            line-height: 1.75;
            margin-bottom: 1.1rem;
        }

        .note p:last-child {
            margin-bottom: 0;
        }

        .note strong {
            color: var(--highlight);
            font-weight: 600;
        }

        .projects {
            display: grid;
            gap: 3.5rem;
        }

        .project-group {
            animation: fadeInUp 0.8s ease-out backwards;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .project-group:nth-child(1) { animation-delay: 0.05s; }
        .project-group:nth-child(2) { animation-delay: 0.1s; }
        .project-group:nth-child(3) { animation-delay: 0.15s; }
        .project-group:nth-child(4) { animation-delay: 0.2s; }
        .project-group:nth-child(5) { animation-delay: 0.25s; }
        .project-group:nth-child(6) { animation-delay: 0.3s; }
        .project-group:nth-child(7) { animation-delay: 0.35s; }
        .project-group:nth-child(8) { animation-delay: 0.4s; }
        .project-group:nth-child(9) { animation-delay: 0.45s; }

        .video-card {
            background: var(--secondary);
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .video-card:hover {
            border-color: var(--accent);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
        }

        .video-iframe-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            background: var(--primary);
        }

        .video-iframe-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        .video-info {
            padding: 1.5rem;
        }

        .video-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--highlight);
            margin-bottom: 0.35rem;
            line-height: 1.3;
        }

        .video-tag {
            display: inline-block;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--accent-subtle);
            margin-bottom: 0.75rem;
        }

        .video-caption {
            font-size: 0.95rem;
            color: var(--accent-subtle);
            line-height: 1.65;
            margin-top: 0.75rem;
        }

        .video-link {
            color: var(--accent-subtle);
            text-decoration: none;
            font-size: 0.9rem;
            display: inline-block;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            width: 100%;
            transition: color 0.3s;
        }

        .video-link:hover {
            color: var(--accent);
        }

        @media (max-width: 768px) {
            h1 { font-size: 1.9rem; }
            header { padding: 2rem 1rem; }
            main { padding: 2.5rem 1rem; }
        }

        footer {
            border-top: 1px solid var(--border);
            padding: 2rem;
            text-align: center;
            color: var(--accent-subtle);
            font-size: 0.9rem;
        }
    </style>
</head>
